{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2020",
    "sourceMap": true,
    "noEmitOnError": true,
    "rootDir": "..",
    "outDir": "dist",
    "esModuleInterop": true,
    // La logica di dominio richiede controllo stretto dei tipi.
    "strict": true,
    // Ignora i tipi dei peer opzionali delle dipendenze esterne.
    "skipLibCheck": true
  },
  // Include il contratto condiviso che sta fuori da server/src.
  "include": ["src/**/*", "../shared/**/*"]
}
